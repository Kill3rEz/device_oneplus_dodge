From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kill3rEz <98993017+Kill3rEz@users.noreply.github.com>
Date: Wed, 18 Nov 2026 10:15:00 +0100
Subject: [PATCH] dodge: Drop the stock perfd modules

PenguinOS ships perf from the QTI perf component, which defines
vendor.qti.hardware.perf2-hal-service too. With both namespaces exported
the name is ambiguous for the vendor partition.
---
 qti-perfd/Android.bp | 155 -------------------------------------------
 1 file changed, 155 deletions(-)
 delete mode 100644 qti-perfd/Android.bp

diff --git a/qti-perfd/Android.bp b/qti-perfd/Android.bp
deleted file mode 100644
index 2c34058..0000000
--- a/qti-perfd/Android.bp
+++ /dev/null
@@ -1,155 +0,0 @@
-cc_prebuilt_binary {
-    name: "vendor.qti.hardware.perf2-hal-service",
-    vendor: true,
-    proprietary: true,
-    srcs: ["proprietary/vendor/bin/hw/vendor.qti.hardware.perf2-hal-service"],
-    relative_install_path: "hw",
-    init_rc: [
-        "proprietary/vendor/etc/init/vendor.qti.hardware.perf2-hal-service.rc",
-        "vendor.qti.hardware.perf2-hal-service-data.rc",
-    ],
-    vintf_fragments: ["proprietary/vendor/etc/vintf/manifest/vendor.qti.hardware.perf2.xml"],
-    check_elf_files: false,
-    prefer: true,
-}
-
-cc_prebuilt_library_shared {
-    name: "libqti-perfd-client.stock",
-    stem: "libqti-perfd-client",
-    vendor: true,
-    proprietary: true,
-    compile_multilib: "64",
-    strip: {
-        none: true,
-    },
-    check_elf_files: false,
-    srcs: ["proprietary/vendor/lib64/libqti-perfd-client.so"],
-}
-
