From 3809e650c21cfd205c16e503776787e867af4cec Mon Sep 17 00:00:00 2001
From: Kill3rEz <98993017+Kill3rEz@users.noreply.github.com>
Date: Thu, 29 Oct 2026 14:33:00 +0100
Subject: [PATCH] keystore2: Fall back to software attestation in auto mode

When the hardware cannot attest, auto mode returned the KeyMint error to the caller. Generate the key in software instead and keep doing so until reboot.
---
 keystore2/src/attestation_compat.rs | 43 ++++++++++++++++++++++++++++-
 keystore2/src/security_level.rs     | 23 ++++++++++++---
 2 files changed, 61 insertions(+), 5 deletions(-)

diff --git a/keystore2/src/attestation_compat.rs b/keystore2/src/attestation_compat.rs
index e1970ee3..1418b24c 100644
--- a/keystore2/src/attestation_compat.rs
+++ b/keystore2/src/attestation_compat.rs
@@ -1,6 +1,7 @@
 // SPDX-FileCopyrightText: 2026 kenway214
 // SPDX-License-Identifier: Apache-2.0
 
+use crate::error::{Error, ErrorCode};
 use crate::utils::{AndroidUserId, AppUid};
 use android_hardware_security_keymint::aidl::android::hardware::security::keymint::{
     Algorithm::Algorithm, Certificate::Certificate, KeyCreationResult::KeyCreationResult,
@@ -24,6 +25,7 @@ use packagemanager_aidl::aidl::android::content::pm::IPackageManagerNative::IPac
 use std::collections::HashMap;
 use std::fs;
 use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
 use std::sync::{LazyLock, Mutex};
 use android_system_keystore2::aidl::android::system::keystore2::{
     Domain::Domain, KeyDescriptor::KeyDescriptor,
@@ -72,6 +74,7 @@ static TRACKED_ATTEST_KEY_MATERIAL: LazyLock<Mutex<HashMap<String, String>>> =
     LazyLock::new(|| Mutex::new(HashMap::new()));
 static TRACKED_ATTEST_SIGNERS: LazyLock<Mutex<HashMap<String, TrackedAttestSignerState>>> =
     LazyLock::new(|| Mutex::new(HashMap::new()));
+static HW_ATTESTATION_UNAVAILABLE: AtomicBool = AtomicBool::new(false);
 
 #[derive(Clone, Copy, Debug, Eq, PartialEq)]
 enum CompatAttestMode {
@@ -402,10 +405,48 @@ pub(crate) fn should_force_software_generation_for_uid(
     let target_mode = get_target_mode_for_packages(&cfg, &uid_packages).unwrap_or(cfg.mode);
     match target_mode {
         CompatAttestMode::Generate => true,
-        CompatAttestMode::Patch | CompatAttestMode::Auto => false,
+        CompatAttestMode::Auto => HW_ATTESTATION_UNAVAILABLE.load(Ordering::Relaxed),
+        CompatAttestMode::Patch => false,
     }
 }
 
+fn is_hw_attestation_failure(err: &anyhow::Error) -> bool {
+    matches!(
+        err.root_cause().downcast_ref::<Error>(),
+        Some(Error::Km(ErrorCode::SECURE_HW_COMMUNICATION_FAILED))
+            | Some(Error::Km(ErrorCode::ATTESTATION_KEYS_NOT_PROVISIONED))
+    )
+}
+
+pub(crate) fn should_fallback_to_software_generation_for_uid(
+    caller_uid: AppUid,
+    creation_params: &[KeyParameter],
+    err: &anyhow::Error,
+) -> bool {
+    if !has_attestation_challenge(creation_params) || !is_hw_attestation_failure(err) {
+        return false;
+    }
+    let Ok(cfg) = load_config_for_user(caller_uid.owning_user()) else {
+        return false;
+    };
+    if !cfg.enabled || cfg.target_packages.is_empty() {
+        return false;
+    }
+    let Ok(uid_packages) = package_names_for_uid(caller_uid) else {
+        return false;
+    };
+    if get_target_mode_for_packages(&cfg, &uid_packages) != Some(CompatAttestMode::Auto) {
+        return false;
+    }
+    if !HW_ATTESTATION_UNAVAILABLE.swap(true, Ordering::Relaxed) {
+        warn!(
+            "[KEYSTORE_COMPAT] Hardware attestation unavailable ({:?}), using software generation",
+            err.root_cause()
+        );
+    }
+    true
+}
+
 fn attestation_application_id(params: &[KeyParameter]) -> &[u8] {
     params
         .iter()
diff --git a/keystore2/src/security_level.rs b/keystore2/src/security_level.rs
