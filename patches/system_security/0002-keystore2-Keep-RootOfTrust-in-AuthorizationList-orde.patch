From 8fff7ce2b3bf594cbc6e8b68ad0e68c6fd8235f3 Mon Sep 17 00:00:00 2001
From: Kill3rEz <98993017+Kill3rEz@users.noreply.github.com>
Date: Sun, 4 Oct 2026 23:28:05 +0200
Subject: [PATCH 2/2] keystore2: Keep RootOfTrust in AuthorizationList order

The patched RootOfTrust was appended at the end of teeEnforced
instead of its position in the schema.
---
 keystore2/src/crypto/crypto.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/keystore2/src/crypto/crypto.cpp b/keystore2/src/crypto/crypto.cpp
index 0d58ef0c..f3866b77 100644
--- a/keystore2/src/crypto/crypto.cpp
+++ b/keystore2/src/crypto/crypto.cpp
@@ -701,6 +701,7 @@ static bool replaceRootOfTrustInTeeEnforced(const std::vector<uint8_t>& tee_enfo
     const uint8_t* items = tee_enforced_der.data() + seq_hdr;
     size_t items_len = tee_enforced_der.size() - seq_hdr;
     size_t pos = 0;
+    size_t rot_pos = SIZE_MAX;
     std::vector<uint8_t> rebuilt_items;
     rebuilt_items.reserve(items_len + 128);
     while (pos < items_len) {
@@ -710,6 +711,9 @@ static bool replaceRootOfTrustInTeeEnforced(const std::vector<uint8_t>& tee_enfo
         if (!parseOneDerElement(items + pos, items_len - pos, &el_total, &el_hdr, &tag_no, &is_ctx)) {
             return false;
         }
+        if (rot_pos == SIZE_MAX && is_ctx && tag_no >= 704) {
+            rot_pos = rebuilt_items.size();
+        }
         if (!(is_ctx && tag_no == 704)) {
             rebuilt_items.insert(rebuilt_items.end(), items + pos, items + pos + el_total);
         }
@@ -737,7 +741,8 @@ static bool replaceRootOfTrustInTeeEnforced(const std::vector<uint8_t>& tee_enfo
     rot_tagged.push_back(0x40);
     appendDerLength(&rot_tagged, rot_seq.size());
     rot_tagged.insert(rot_tagged.end(), rot_seq.begin(), rot_seq.end());
-    rebuilt_items.insert(rebuilt_items.end(), rot_tagged.begin(), rot_tagged.end());
+    rebuilt_items.insert(rot_pos == SIZE_MAX ? rebuilt_items.end() : rebuilt_items.begin() + rot_pos,
+                         rot_tagged.begin(), rot_tagged.end());
 
     *out = makeDerTlv(0x30, rebuilt_items);
     return true;
-- 
