<resources>
    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">8dp</dimen>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <dimen name="physical_power_button_center_screen_location_y">1000px</dimen>

    <!-- Default device corner radius, used for assist UI -->
    <dimen name="config_rounded_mask_size">156px</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">49.49</item>

    <!-- Alert slider dialog. Middle is stock's spot (SystemUIResOverlay.23893, sw411dp:
         160.975dp from the top); up and down sit 28dp either side so the dialog follows the
         slider. SystemUI adds the 45.67dp status bar to the portrait values. -->
    <dimen name="tri_state_up_dialog_position">87.3dp</dimen>
    <dimen name="tri_state_middle_dialog_position">115.3dp</dimen>
    <dimen name="tri_state_down_dialog_position">143.3dp</dimen>
    <dimen name="tri_state_up_dialog_position_l">135.86dp</dimen>
    <dimen name="tri_state_middle_dialog_position_l">135.86dp</dimen>
    <dimen name="tri_state_down_dialog_position_l">135.86dp</dimen>
</resources>
