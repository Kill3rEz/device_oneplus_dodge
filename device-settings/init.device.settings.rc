# One-shot: old default was stock soft (op13gentle/op13soft). Stock OOS uses
# def_style. Flip persist once, then leave the Settings picker alone.
on post-fs-data && property:persist.sys.haptic_migrated_op13def=0
    setprop persist.sys.haptic_profile op13crisp
    setprop persist.sys.haptic_migrated_op13def 1

on boot
    # Charger nodes (cool_down) are commonized in sm8750-common ueventd.oplus.rc
    # and chowned by the charger driver when the attr is created. The boot
    # trigger fires before the driver registers the node, so a chown here is
    # inert. The display nodes below already exist here.
    # Display
    chown system system /sys/kernel/oplus_display/pwm_onepulse
    chmod 0666 /sys/kernel/oplus_display/pwm_onepulse
    chown system system /sys/kernel/oplus_display/hbm_max
    chmod 0664 /sys/kernel/oplus_display/hbm_max
    # AOD light mode (0 = 50 nits, 1 = 10 nits); odm init.oplus.display.rc
    # already opens this, repeated here so we do not depend on it
    chown system system /sys/kernel/oplus_display/aod_light_mode_set
    chmod 0666 /sys/kernel/oplus_display/aod_light_mode_set
    chown system system /sys/kernel/oplus_display/write_panel_reg
    chmod 0666 /sys/kernel/oplus_display/write_panel_reg
    # Panel test-TE counter (real DDIC refresh rate), read by SurfaceFlinger's
    # "Show refresh rate" overlay. Its irq is armed only while that overlay
    # polls, see sys.sf.panel_te below.
    chown system system /sys/kernel/oplus_display/test_te
    chmod 0664 /sys/kernel/oplus_display/test_te
    # ADFR min fps request (0 = dynamic LTPO, N = fixed); written by
    # RefreshRateMonitorService alongside the MIN/PEAK refresh rate settings
    chown system system /sys/kernel/oplus_display/min_fps
    chmod 0664 /sys/kernel/oplus_display/min_fps

# SurfaceFlinger sets sys.sf.panel_te while its refresh rate overlay polls
# the panel. The test-TE irq fires on every refresh, so keep it off otherwise.
on property:sys.sf.panel_te=1
    write /sys/kernel/oplus_display/test_te 1

on property:sys.sf.panel_te=0
    write /sys/kernel/oplus_display/test_te 0

# A framework restart brings back cameraserver and audioserver but not the
# camera provider. Its shake detector keeps a dead sensorservice connection
# and spins a prime core until the next reboot, so restart it with zygote.
on property:init.svc.zygote=restarting
    restart vendor.camera-provider
