<resources>
    <!-- Paths to the libraries that contain device specific key handlers -->
    <string-array name="config_deviceKeyHandlerLibs" translatable="false">
        <item>/system_ext/priv-app/DeviceSettings/DeviceSettings.apk</item>
        <item>/system_ext/priv-app/Settings/Settings.apk</item>
    </string-array>

    <!-- Names of the key handler classes -->
    <string-array name="config_deviceKeyHandlerClasses" translatable="false">
        <item>org.lineageos.device.settings.KeyHandler</item>
        <item>com.android.settings.lineage.gestures.KeyHandler</item>
    </string-array>

    <!-- AOSPA off-screen gestures (Settings > Gestures). The OPlus touch driver reports a
         double tap as KEY_WAKEUP (scan code 143); the AOSPA KeyHandler matches scan codes. -->
    <bool name="config_enableKeyHandler">true</bool>
    <integer name="config_doubleTapKeyCode">143</integer>
    <!-- Default action for double tap: wake up (AOSPA KeyHandler WAKE_UP). -->
    <integer name="config_doubleTapDefault">1</integer>
</resources>
